# 必須: プロジェクトのフォルダ名（devcontainer.json の workspaceFolder と一致させる）
PROJECT_NAME=my-project

# 必須: 推論サーバーのIPアドレス
DEV_INFER_IP=192.168.1.100

# 任意: ホスト側のCaddyルート証明書パス（デフォルトと異なる場合のみ指定）
# HOST_CA_CERT_PATH=/Users/username/Library/Application Support/Caddy/pki/authorities/local/root.crt

# 任意: ベースイメージを変更したい場合のみ指定
# DEVCONTAINER_IMAGE=mcr.microsoft.com/devcontainers/typescript-node:26-trixie
